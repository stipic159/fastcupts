{
  "name": "fastcup-tournament-scout",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": { "node": ">=24.0.0", "pnpm": ">=10.0.0" },
  "scripts": {
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint",
    "format": "prettier --write .",
    "dev:extension": "pnpm --filter @fastcup/extension dev",
    "dev:backend": "pnpm --filter @fastcup/backend dev"
  },
  "devDependencies": { "@eslint/js": "^9.0.0", "@types/node": "^24.0.0", "eslint": "^9.0.0", "prettier": "^3.5.0", "typescript": "^5.8.0", "typescript-eslint": "^8.0.0" }
